      "versionNonce": 1009, "isDeleted": false, "boundElements": null, "updated": 1700000000000,
      "link": null, "locked": false,
      "text": "Table needs E entries — one per possible percept sequence:   E = Σ (t=1→T) Pᵗ",
      "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18,
      "containerId": null,
      "originalText": "Table needs E entries — one per possible percept sequence:   E = Σ (t=1→T) Pᵗ",
      "lineHeight": 1.25
    },
    {
      "id": "formula2", "type": "text", "x": 40, "y": 180, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 110, "version": 1,
      "versionNonce": 1010, "isDeleted": false, "boundElements": null, "updated": 1700000000000,
      "link": null, "locked": false,
      "text": "(an entry must be defined for every possible percept sequence, even for small P and T this grows fast)",
      "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14,
      "containerId": null,
      "originalText": "(an entry must be defined for every possible percept sequence, even for small P and T this grows fast)",
      "lineHeight": 1.25
    },
    {
      "id": "sectionTitle", "type": "text", "x": 40, "y": 218, "width": 840, "height": 32,
