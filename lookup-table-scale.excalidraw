      "versionNonce": 1011, "isDeleted": false, "boundElements": null, "updated": 1700000000000,
      "link": null, "locked": false,
      "text": "Scale check: an automated driving agent",
      "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 22,
      "containerId": null, "originalText": "Scale check: an automated driving agent", "lineHeight": 1.25
    },
    {
      "id": "rectD", "type": "rectangle", "x": 40, "y": 265, "width": 380, "height": 130,
      "angle": 0, "strokeColor": "#495057", "backgroundColor": "#e9ecef", "fillStyle": "solid",
