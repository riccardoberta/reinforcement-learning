      "versionNonce": 1022, "isDeleted": false, "boundElements": null, "updated": 1700000000000,
      "link": null, "locked": false,
      "text": "E ≈ 10^700,000,000,000 entries",
      "fontSize": 26, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "baseline": 26,
      "containerId": null, "originalText": "E ≈ 10^700,000,000,000 entries", "lineHeight": 1.25
