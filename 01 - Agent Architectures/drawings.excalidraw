      "updated": 1788019280494,
      "link": null,
      "locked": false,
      "text": "Two vacuum agents share the same\nrooms. Whoever cleans a square first\nleaves nothing for the other: each\nagent's choices affect what the other\nshould rationally do.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two vacuum agents share the same\nrooms. Whoever cleans a square first\nleaves nothing for the other: each\nagent's choices affect what the other\nshould rationally do.",
      "autoResize": true,
      "lineHeight": 1.25
    },
