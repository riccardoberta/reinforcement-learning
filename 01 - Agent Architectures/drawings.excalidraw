      "text": "each one's actions\nchange what the other\nshould do next",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "each one's actions\nchange what the other\nshould do next",
      "lineHeight": 1.25,
      "index": "bGZ",
      "autoResize": true
    },
    {
      "id": "E4lM-A3j0PZhzpm2NO-tt",
      "type": "text",
      "x": 559.8598817749652,
      "y": 2022.4682164248213,
      "width": 231.8681640625,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2086821032,
      "version": 178,
      "versionNonce": 762159576,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787765971046,
      "link": null,
      "locked": false,
      "text": "Two vacuum agents share the same\nrooms. Whoever cleans a square first\nleaves nothing for the other — each\nagent's choices affect what the other\nshould rationally do.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Two vacuum agents share the same\nrooms. Whoever cleans a square first\nleaves nothing for the other — each\nagent's choices affect what the other\nshould rationally do.",
      "lineHeight": 1.25,
      "index": "bGa",
      "autoResize": true
    },
    {
      "id": "LJyjOE68aubO8N_mwrSXd",
      "type": "text",
      "x": 79.85988177496517,
      "y": 2167.4682164248215,
      "width": 860,
      "height": 30,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 473991080,
      "version": 177,
      "versionNonce": 1662519208,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787765971046,
      "link": null,
      "locked": false,
      "text": "Same rooms, same dirt — what changes is whether another agent's behavior has to be modeled at all.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Same rooms, same dirt — what changes is whether another agent's behavior has to be modeled at all.",
      "lineHeight": 1.25,
      "index": "bGb",
      "autoResize": true
    },
