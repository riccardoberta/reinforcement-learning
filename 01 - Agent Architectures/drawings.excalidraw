      "updated": 1787765971046,
      "link": null,
      "locked": false,
      "text": "Only one vacuum agent operates here.\nDirt, walls and furniture behave\npassively — they are objects, not\nagents whose behavior you must model.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Only one vacuum agent operates here.\nDirt, walls and furniture behave\npassively — they are objects, not\nagents whose behavior you must model.",
