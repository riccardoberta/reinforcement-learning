      "updated": 1788019280494,
      "link": null,
      "locked": false,
      "text": "Only one vacuum agent operates here.\nDirt, walls and furniture behave\npassively: they are objects, not\nagents whose behavior we must model.",
      "fontSize": 16.0081171267707,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only one vacuum agent operates here.\nDirt, walls and furniture behave\npassively: they are objects, not\nagents whose behavior we must model.",
      "autoResize": true,
      "lineHeight": 1.25
    },
