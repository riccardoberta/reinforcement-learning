    {
      "id": "P92y6F6Dex4XNKKup3eCR",
      "type": "text",
      "x": 285.7543309703724,
      "y": 10026.350242114459,
      "width": 780.079345703125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTe",
      "roundness": null,
      "seed": 1645174253,
      "version": 3,
      "versionNonce": 1192789677,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791886346362,
      "created": 1791886345120,
      "link": null,
      "locked": false,
      "text": "Compared with Cart-Pole, the agent must coordinate more aspects of motion and balance competing\nobjectives. This makes LunarLander a useful setting for investigating whether Double DQN,\nprioritized experience replay and other extensions improve learning speed, stability and final\nperformance. We will first establish a DQN baseline, then compare each extension under the same\nexperimental conditions.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compared with Cart-Pole, the agent must coordinate more aspects of motion and balance competing objectives. This makes LunarLander a useful setting for investigating whether Double DQN, prioritized experience replay and other extensions improve learning speed, stability and final performance. We will first establish a DQN baseline, then compare each extension under the same experimental conditions.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
