      "text": "$\\displaystyle \\theta \\leftarrow \\theta + \\alpha\\, \\big[ \\text{Target} - Q(s,a;\\theta) \\big]\\,\n\\phi(s,a)$",
      "fontSize": 16,
      "baseFontSize": null,
