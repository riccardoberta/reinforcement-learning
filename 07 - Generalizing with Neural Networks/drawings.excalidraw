      "isDeleted": false,
      "boundElements": [],
      "updated": 1791310339933,
      "link": null,
      "locked": false,
      "text": "The momentum adds an \"inertia\" term, allowing \nthe optimizer to move in consistent directions \nand dampen oscillations, leading to faster and \nmore stable convergence. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The momentum adds an \"inertia\" term, allowing \nthe optimizer to move in consistent directions \nand dampen oscillations, leading to faster and \nmore stable convergence. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
