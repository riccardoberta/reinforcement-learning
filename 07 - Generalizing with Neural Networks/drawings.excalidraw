      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 5,
      "text": "The action-value function doesn't\ncapture the relationship directly,\nbut it helps determine the\nfavorable action to take. On the\nleft it's not clear what to do,\nwhile in the right it is obvious",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The action-value function doesn't capture the relationship directly, but it helps determine the favorable action to take. On the left it's not clear what to do, while in the right it is obvious",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1791313226037,
      "labelPosition": null,
      "baseFontSize": null
    },
