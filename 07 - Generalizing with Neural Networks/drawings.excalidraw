    },
    {
      "id": "dif8G_9mkXzZDwuQDWwAT",
      "type": "image",
      "x": 1648.2352096028221,
      "y": 10258.732686687907,
      "width": 1169.7478991596638,
      "height": 580,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#a5d8ff",
