      "updated": 1761209458596,
      "link": null,
      "locked": false,
      "status": "saved",
      "fileId": "178a87650e7c5fc010fff1322ce6a639da1d54e30f58a2b7f8f495a210937ec9b64dc1732f80b65afb0ed1b2ef940b7f",
      "scale": [
        1,
